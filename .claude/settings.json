{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:core)",
      "Bash(npm run test:ui)",
      "Bash(npm run test:collector)",
      "Bash(npm run test:large)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-shell.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
