{
  "name": "topo-mikrotik",
  "version": "1.0.0",
  "description": "由 MikroTik RouterOS CLI 輸出建立網路現況基準（SSOT）：拓樸、VLAN、MAC/IP、路由與一致性檢查。純前端、可離線、零相依套件。",
  "private": true,
  "scripts": {
    "test": "node tests/run.js && node tests/docs.js && bash tests/collect.sh && node tests/ui-smoke.js",
    "test:core": "node tests/run.js",
    "test:docs": "node tests/docs.js",
    "test:collector": "bash tests/collect.sh",
    "test:ui": "node tests/ui-smoke.js",
    "test:large": "node tests/run.js --large",
    "golden:update": "node tools/update-golden.js",
    "sample": "node tools/gen-bundle.js --sites 1 --access 12 --faults > samples/sample-bundle.txt && node tools/embed-sample.js",
    "gen:large": "node tools/gen-bundle.js --sites 40 --access 24 > samples/large-1000.txt",
    "oui": "node tools/build-oui.js"
  }
}