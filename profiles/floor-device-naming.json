{
  "schema": "ssot-profile/1",
  "id": "floor-device-naming",
  "version": "2",
  "label": "樓層_設備型號_編號（例：3F_hAP_01、B1F-RB5009）",
  "stripDomain": true,
  "alias": {},
  "classify": [
    {
      "match": "(^|[_-])(wAP|hAP|cAP)([_-]|\\d|$)",
      "role": "AP"
    },
    {
      "match": "(^|[_-])(RB3011|RB5009)([_-]|$)",
      "kind": "router",
      "role": "RTR"
    }
  ],
  "group": {
    "match": "^(B?[0-9]+F)[_-]",
    "value": "$1"
  },
  "label": {
    "match": "^B?[0-9]+F[_-](.+)$",
    "value": "$1"
  }
}
