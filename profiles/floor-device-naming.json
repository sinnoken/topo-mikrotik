{
  "schema": "ssot-profile/1",
  "id": "floor-device-naming",
  "version": "1",
  "label": "樓層_設備型號",
  "stripDomain": true,
  "alias": {},
  "classify": [
    {
      "match": "(^|_)(wAP|hAP)",
      "role": "AP"
    },
    {
      "match": "(^|_)(RB3011|RB5009)$",
      "kind": "router",
      "role": "RTR"
    }
  ],
  "group": {
    "match": "^([0-9]+F)[_-]",
    "value": "$1"
  },
  "label": {
    "match": "^[0-9]+F[_-](.+)$",
    "value": "$1"
  }
}
